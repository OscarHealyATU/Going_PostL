
#Panel {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}
.unity-base-slider__dragger {
    background-color: #ce4948;
    border-radius: 999px;
    border-width: 0;
    width: 16px;
    height: 16px;
    top: 25px;
}   

.unity-base-slider__drag-container {
    margin-left: 20px;
    margin-right: 20px;
}

.unity-base-slider > .unity-label {
    color: #cccccc;
    font-size: 22px;
    width: 200px;
}
#Logo {
    height: 100px;
    width: 100px;
}
DropdownField > .unity-label {
    width: 200px;
}

Toggle .unity-toggle__checkmark {
    background-image: none;
    background-color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
}

Toggle:checked .unity-toggle__checkmark {
    background-image: none;
    background-color: #ce4948;
    border-radius: 50%;
    width: 25px;
    height: 25px;
}